{
  "name": "web3dmapcreator",
  "private": true,
  "version": "1.0.0",
  "description": "Turn any area of a map into a multicolour 3D printable city model, in the browser.",
  "license": "GPL-3.0-or-later",
  "author": "Jarvizar",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate": "tsx scripts/generate.ts"
  },
  "dependencies": {
    "@kninnug/constrainautor": "^4.1.0",
    "clipper2-ts": "^2.0.1-18",
    "delaunator": "^5.1.0",
    "earcut": "^3.2.3",
    "fast-png": "^8.0.0",
    "fflate": "^0.8.3",
    "fzstd": "^0.1.1",
    "hyparquet": "^1.31.2",
    "lucide-react": "^1.48.0",
    "maplibre-gl": "^6.11.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/delaunator": "^5.0.3",
    "@types/earcut": "^3.0.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
